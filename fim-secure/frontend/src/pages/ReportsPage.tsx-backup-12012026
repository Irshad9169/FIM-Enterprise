import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { useNavigate } from "react-router-dom";
import { fetchReports, generateReport, deleteReport } from "../api/dashboard";
import { useState } from "react";
import { Trash2 } from "lucide-react";

export default function ReportsPage() {
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const [selectedDate, setSelectedDate] = useState("");
  const [generating, setGenerating] = useState(false);
  
  const { data, isLoading, error, refetch } = useQuery({
    queryKey: ["reports"],
    queryFn: () => fetchReports(30),
  });

  const deleteMutation = useMutation({
    mutationFn: deleteReport,
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["reports"] });
    },
  });

  const handleGenerateReport = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!selectedDate) {
      alert('Please select a date');
      return;
    }

    setGenerating(true);
    try {
      const result = await generateReport(selectedDate);
      const msg = result.total_changes === 0
        ? `✅ Empty report generated for ${selectedDate}\n\nNo file changes detected on this date.`
        : `✅ Report generated successfully!\n\nDate: ${selectedDate}\nChanges: ${result.total_changes}\nServers: ${result.total_servers}\n\nAdded: ${result.breakdown?.added || 0}\nRemoved: ${result.breakdown?.removed || 0}\nChanged: ${result.breakdown?.changed || 0}`;
      alert(msg);
      setSelectedDate('');
      refetch();
    } catch (err: any) {
      const errorMsg = err.message || 'Failed to generate report';
      if (errorMsg.includes('already exists')) {
        alert(`⚠️ Report already exists for ${selectedDate}\n\nDelete the existing report first or choose a different date.`);
      } else {
        alert(`❌ Error: ${errorMsg}`);
      }
      console.error(err);
    } finally {
      setGenerating(false);
    }
  };

  const handleDelete = async (reportId: string, reportDate: string, e: React.MouseEvent) => {
    e.stopPropagation(); // Prevent navigation to detail page
    
    if (!confirm(`Delete report for ${reportDate}?\n\nThis will permanently remove the report and all associated data.`)) {
      return;
    }

    try {
      await deleteMutation.mutateAsync(reportId);
      alert(`✅ Report for ${reportDate} deleted successfully`);
    } catch (err) {
      alert('❌ Failed to delete report');
      console.error(err);
    }
  };

  if (isLoading) return <div className="text-center py-8">Loading reports...</div>;
  if (error) return <div className="text-center py-8 text-red-400">Error loading reports</div>;

  const reports = data || [];

  const getStatusBadge = (status: string) => {
    const colors = {
      pending: "bg-yellow-900/40 text-yellow-300 border-yellow-700",
      in_review: "bg-blue-900/40 text-blue-300 border-blue-700",
      reviewed: "bg-green-900/40 text-green-300 border-green-700",
      submitted: "bg-purple-900/40 text-purple-300 border-purple-700",
    };
    return colors[status as keyof typeof colors] || colors.pending;
  };

  return (
    <div>
      <div className="flex items-center justify-between mb-4">
        <h1 className="text-xl font-semibold">Daily Reports</h1>
        
        <form onSubmit={handleGenerateReport} className="flex gap-2">
          <input
            type="date"
            className="bg-slate-900 border border-slate-700 rounded px-3 py-1.5 text-sm"
            value={selectedDate}
            onChange={(e) => setSelectedDate(e.target.value)}
            max={new Date().toISOString().split('T')[0]}
          />
          <button
            type="submit"
            disabled={generating}
            className="px-4 py-1.5 bg-sky-600 hover:bg-sky-700 disabled:bg-slate-700 rounded text-sm"
          >
            {generating ? 'Generating...' : 'Generate Report'}
          </button>
        </form>
      </div>

      <div className="space-y-3">
        {reports.map((report: any) => (
          <div
            key={report.id}
            className="bg-slate-900 border border-slate-800 rounded-lg p-4 hover:border-sky-700 transition-colors"
          >
            <div className="flex items-start justify-between">
              <div 
                className="flex-1 cursor-pointer"
                onClick={() => navigate(`/reports/${report.report_date}`)}
              >
                <div className="flex items-center gap-2 mb-1">
                  <div className="text-base font-semibold">
                    FIM Report - {report.report_date}
                  </div>
                  <span
                    className={`px-2 py-0.5 rounded text-xs border ${getStatusBadge(
                      report.status
                    )}`}
                  >
                    {report.status}
                  </span>
                  {report.total_changes === 0 && (
                    <span className="px-2 py-0.5 rounded text-xs bg-slate-700 text-slate-400">
                      Empty
                    </span>
                  )}
                </div>
                <div className="text-sm text-slate-400">
                  {report.total_changes} changes · {report.agents?.length || 0} agents
                </div>
              </div>

              <div className="flex items-center gap-3">
                <div className="text-xs text-slate-500">
                  {new Date(report.created_at).toLocaleString()}
                </div>
                
                <button
                  onClick={(e) => handleDelete(report.id, report.report_date, e)}
                  className="p-2 text-red-400 hover:text-red-300 hover:bg-red-900/20 rounded transition-colors"
                  title="Delete report"
                >
                  <Trash2 size={16} />
                </button>
              </div>
            </div>

            <div 
              className="mt-3 flex gap-2 cursor-pointer"
              onClick={() => navigate(`/reports/${report.report_date}`)}
            >
              <div className="px-3 py-1 bg-slate-950 rounded text-xs">
                <span className="text-slate-500">Added:</span>{" "}
                <span className="text-green-300">{report.summary?.added_files || 0}</span>
              </div>
              <div className="px-3 py-1 bg-slate-950 rounded text-xs">
                <span className="text-slate-500">Removed:</span>{" "}
                <span className="text-red-300">{report.summary?.removed_files || 0}</span>
              </div>
              <div className="px-3 py-1 bg-slate-950 rounded text-xs">
                <span className="text-slate-500">Changed:</span>{" "}
                <span className="text-yellow-300">{report.summary?.changed_files || 0}</span>
              </div>
            </div>
          </div>
        ))}

        {reports.length === 0 && (
          <div className="text-center py-12 text-slate-400">
            No reports found. Generate your first report using the form above!
          </div>
        )}
      </div>
    </div>
  );
}
