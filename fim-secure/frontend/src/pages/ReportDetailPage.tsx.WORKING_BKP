import { useParams, useNavigate } from "react-router-dom";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { fetchReportDetail, updateReportStatus } from "../api/dashboard";
import { Download, ArrowLeft, FileText, CheckCircle, ChevronDown, ChevronUp, Printer, Link as LinkIcon, ExternalLink } from "lucide-react";
import { useState } from "react";

export default function ReportDetailPage() {
  const { reportId } = useParams<{ reportId: string }>();
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const [expandedAgents, setExpandedAgents] = useState<Record<string, boolean>>({});

  const { data: report, isLoading } = useQuery({
    queryKey: ["report", reportId],
    queryFn: () => fetchReportDetail(reportId!),
    enabled: !!reportId,
  });

  const toggleAgent = (agent: string) => {
    setExpandedAgents(prev => ({...prev, [agent]: !prev[agent]}));
  };

  if (isLoading) return <div className="text-center py-12 text-slate-400">Loading Report Details...</div>;
  if (!report) return <div className="text-center py-12 text-slate-400">Report not found</div>;

  return (
    <div className="space-y-6">
      <div className="flex justify-between items-center print:hidden">
        <button onClick={() => navigate('/reports')} className="px-4 py-2 bg-slate-800 text-white rounded text-sm flex items-center gap-2 hover:bg-slate-700">
          <ArrowLeft size={16} /> Back
        </button>
        <div className="flex gap-2">
            <button onClick={() => window.open(`/api/v1/reports/${reportId}/export`, '_blank')} className="px-4 py-2 bg-slate-800 text-slate-200 border border-slate-700 rounded text-sm flex items-center gap-2 hover:bg-slate-700"><FileText size={16} /> View HTML</button>
            <button onClick={() => window.print()} className="px-4 py-2 bg-slate-800 text-slate-200 border border-slate-700 rounded text-sm flex items-center gap-2 hover:bg-slate-700"><Printer size={16} /> PDF</button>
            <button onClick={() => updateReportStatus(reportId!, 'reviewed').then(() => queryClient.invalidateQueries())} className="px-4 py-2 bg-green-600 text-white rounded text-sm flex items-center gap-2 hover:bg-green-700"><CheckCircle size={16} /> Review</button>
        </div>
      </div>

      <div className="bg-slate-900 border border-slate-800 p-6 rounded shadow-sm">
        <h1 className="text-2xl font-bold text-white">FIM-report-{report.report_date}.htm</h1>
        <div className="flex justify-between mt-2 text-sm text-slate-400">
            <div>Date: {report.report_date} • Status: <span className="uppercase font-bold text-sky-400">{report.status}</span></div>
            <div>Total Alerts: {report.total_changes}</div>
        </div>
      </div>

      <h2 className="text-lg font-bold text-slate-300">Alerts by Agent</h2>
      {report.agents?.map((agent: string) => (
        <AgentSection key={agent} agent={agent} report={report} isExpanded={!expandedAgents[agent]} onToggle={() => toggleAgent(agent)} />
      ))}
    </div>
  );
}

function AgentSection({ agent, report, isExpanded, onToggle }: any) {
  const details = report.details?.filter((d: any) => d.agent_hostname === agent || report.agents.length === 1) || [];
  
  // Dynamic Ticket Search for this hostname
  const { data: tickets } = useQuery({
    queryKey: ["tickets", agent],
    queryFn: async () => {
        const token = localStorage.getItem("fim_token");
        const res = await fetch(`/api/v1/integrations/search?hostname=${agent}`, {
            headers: { Authorization: `Bearer ${token}` }
        });
        return res.json();
    }
  });

  return (
    <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
      <div className="lg:col-span-2 bg-slate-900 rounded border border-slate-800 shadow-sm overflow-hidden">
        <div className="p-4 bg-slate-800/50 border-b border-slate-800 flex justify-between items-center cursor-pointer" onClick={onToggle}>
          <div className="font-bold text-white">{agent} ({details.length} alerts)</div>
          <ChevronDown size={20} className={!isExpanded ? "" : "rotate-180 text-slate-400"} />
        </div>

        {isExpanded && (
          <div className="p-4 space-y-4 max-h-[600px] overflow-y-auto bg-slate-950">
            {details.map((d: any, idx: number) => (
              <div key={idx} className="border-l-4 border-red-500 p-4 bg-slate-900 rounded-r text-xs font-mono">
                <div className="font-bold text-slate-100 mb-2">modified — <span className="text-pink-400">{d.file_path}</span></div>
                <div className="grid grid-cols-1 gap-1 text-slate-400">
                    <div><span className="text-orange-400 font-bold">Hash:</span> {d.baseline_hash || 'N/A'} → {d.current_hash || 'N/A'}</div>
                    <div><span className="text-slate-200 font-bold">Size:</span> {d.baseline_size || 0} → {d.current_size || 0} bytes</div>
                    <div><span className="text-sky-400 font-bold">Modified:</span> {d.baseline_mtime || 'N/A'} → {d.current_mtime || 'N/A'}</div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div className="space-y-4">
        <div className="bg-slate-900 border border-slate-800 rounded p-4">
          <h3 className="text-sm font-bold text-slate-200 mb-3 flex items-center gap-2"><LinkIcon size={16} className="text-blue-500" /> Related Changes</h3>
          
          <div className="space-y-2">
            {tickets?.cmr?.map((t: any) => (
                <div key={t.id} className="p-3 border border-blue-900/50 rounded bg-blue-900/10 text-xs">
                    <div className="flex justify-between items-start">
                        <div className="text-blue-400 font-bold mb-1">{t.id} (CMR)</div>
                        <span className="text-[10px] bg-green-900/50 text-green-400 px-1 rounded">{t.status}</span>
                    </div>
                    <div className="text-slate-400 mb-2">{t.summary}</div>
                    <button className="w-full py-1 bg-blue-600 text-white rounded font-bold uppercase text-[9px] hover:bg-blue-700">Auto-Link</button>
                </div>
            ))}
            {!tickets?.cmr?.length && !tickets?.jira?.length && <div className="text-slate-500 text-xs italic">No tickets found for this host in the last 7 days.</div>}
          </div>
        </div>
        
        <div className="bg-slate-900 border border-slate-800 rounded p-4">
            <label className="block text-xs font-bold text-slate-400 mb-2 uppercase">Analyst Notes</label>
            <textarea className="w-full bg-slate-950 border border-slate-800 rounded p-2 text-xs text-slate-200 outline-none h-32" placeholder="Enter justification..."></textarea>
            <button className="w-full mt-2 py-2 bg-slate-800 text-white text-xs rounded border border-slate-700 hover:bg-slate-700">Save Notes</button>
        </div>
      </div>
    </div>
  );
}

function SummaryCard({ count, label, color }: { count: number, label: string, color: string }) {
  return (
    <div className="bg-slate-900 p-6 rounded border border-slate-800 shadow-sm">
      <div className={`text-4xl font-bold ${color} mb-1`}>{count}</div>
      <div className="text-xs text-slate-500 font-bold uppercase tracking-wider">{label}</div>
    </div>
  );
}
