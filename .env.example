# =============================================================
# FIM Enterprise — Environment Configuration Template
# Copy this to .env and fill in your values
# NEVER commit .env to git
# =============================================================

# Database
DATABASE_URL=postgresql+asyncpg://fim_app:YOUR_DB_PASSWORD@localhost/fim_db

# Security — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-minimum-32-chars

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256
TOKEN_ISSUER=fim-enterprise

# CORS — required in production. Must be a JSON array of every origin the
# frontend is actually served from (both https:// and http:// if you serve
# both, no trailing slash). Without this, only the localhost dev-server
# defaults are allowed and the real frontend will fail with CORS errors.
# Example matching a typical single-host deployment:
#   CORS_ORIGINS=["https://your-server-hostname","http://your-server-hostname"]
CORS_ORIGINS=["https://your-server-hostname"]

# Email notifications (optional)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_FROM=fim@company.com

# SSO — SSO_SERVER_URL is real as of 2026-09-07 (app/core/sso_manager.py reads
# settings.sso_server_url); SSO_ENABLED/SSO_REALM/SSO_CLIENT_ID below are NOT
# wired to anything anywhere in app/ despite being documented here — dead
# settings, not yet fixed. This custom SSO integration doesn't use a
# realm/client_id concept the way a generic OAuth/Keycloak flow would; whether
# SSO login is available at all is determined by which routes are mounted,
# not a settings flag.
SSO_SERVER_URL=https://auth.int.untd.com/bin/sso

# Daily report auto-generation (optional — defaults shown)
REPORT_AUTO_GENERATE=true
REPORT_SCHEDULE_HOUR=9
REPORT_SCHEDULE_MINUTE=0

# CMR (Phantom) has no dedicated API, only its own web UI behind company
# SSO. Point this at a Netscape-format cookie jar file that holds a valid
# Phantom session; FIM reuses whatever's currently there. Leave empty to
# skip CMR fetching entirely (RT tickets on the Reports page still work).
# Populated by app/services/cmr_session_manager.py's on-demand login,
# triggered from the Correlate All button when there's no valid session
# yet -- the analyst enters their own SSO username/password right then
# (never stored -- see cmr_session_manager.py), same mechanism the legacy
# get_RT_CMRs collector uses, confirmed from its real source: there is no
# service-account concept here, just whatever real credential is entered.
CMR_COOKIE_JAR_PATH=

# Params for the SSO type=login call cmr_session_manager.py makes --
# everything except the username/password, which is supplied per-request
# and never stored. CONFIRMED live (2026-09-18): the SSO server silently
# hangs (no response at all, not even an error) on this login mode when
# given FIM's own origin_id -- it only answers promptly for an origin it
# already recognizes. These are the legacy get_RT_CMRs collector's exact,
# proven-working values -- don't change them to FIM's own identity.
CMR_SSO_ORIGIN_NAME=US Tickets System
CMR_SSO_ORIGIN_ID=USTickets
CMR_SSO_ORIGIN_URL=http://tickets.int.untd.com
