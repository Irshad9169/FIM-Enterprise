"""
Daily Reports API - Using Existing Schema
"""
from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import text
from datetime import date
from typing import Optional
import uuid

from app.core.database import get_db
from app.core.rbac import require_role
from app.models import User
from app.services.report_generator import ReportGenerator

router = APIRouter()

@router.post("/generate/{report_date}")
async def generate_report(
    report_date: date,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(require_role(['admin', 'analyst']))
):
    """Generate daily report"""
    
    # Check if already exists
    result = await db.execute(text("""
        SELECT id FROM fim.reports 
        WHERE report_date = :date
    """), {'date': report_date})
    
    existing = result.fetchone()
    if existing:
        raise HTTPException(400, f"Report already exists for {report_date}")
    
    report_id = await ReportGenerator.generate_daily_report(report_date, db)
    
    if not report_id:
        raise HTTPException(404, "No alerts found for this date")
    
    return {
        'success': True,
        'report_id': str(report_id),
        'report_date': report_date.isoformat()
    }

@router.get("/list")
async def list_reports(
    limit: int = 30,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(require_role(['admin', 'analyst', 'trainee', 'auditor']))
):
    """List all reports"""
    
    result = await db.execute(text("""
        SELECT 
            id, report_date, total_changes, total_servers,
            correlation_groups_count, status, created_at
        FROM fim.reports
        WHERE report_type = 'daily'
        ORDER BY report_date DESC
        LIMIT :limit
    """), {'limit': limit})
    
    reports = result.fetchall()
    
    return {
        'reports': [
            {
                'id': str(r[0]),
                'report_date': r[1].isoformat() if r[1] else None,
                'total_changes': r[2],
                'total_servers': r[3],
                'correlation_groups_count': r[4],
                'status': r[5],
                'created_at': r[6].isoformat() if r[6] else None
            }
            for r in reports
        ]
    }

@router.get("/{report_id}")
