"""
Baseline Management Endpoints
"""
from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, text
from pydantic import BaseModel
from typing import Optional
from datetime import datetime
import uuid

from app.core.database import get_db
from app.core.security import get_current_user
from app.models import User

router = APIRouter()

class BaselineCreateRequest(BaseModel):
    agent_id: str
    scan_id: str
    baseline_name: str
    notes: Optional[str] = None

class BaselineApproveRequest(BaseModel):
    baseline_id: str
    notes: Optional[str] = None

@router.post("/create")
async def create_baseline(
    request: BaselineCreateRequest,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    """Create baseline from a scan"""
    try:
        agent_uuid = uuid.UUID(request.agent_id)
        scan_uuid = uuid.UUID(request.scan_id)
    except ValueError:
        raise HTTPException(400, "Invalid UUID")
    
    # Get scan data
    result = await db.execute(
        text("SELECT scan_data, files_scanned FROM fim.scans WHERE id = :scan_id"),
        {"scan_id": str(scan_uuid)}
    )
    scan = result.fetchone()
    
    if not scan:
        raise HTTPException(404, "Scan not found")
    
    # Deactivate existing active baseline
    await db.execute(
        text("UPDATE fim.baselines SET is_active = FALSE WHERE agent_id = :agent_id AND is_active = TRUE"),
        {"agent_id": str(agent_uuid)}
    )
    
    # Create new baseline
    baseline_id = uuid.uuid4()
    await db.execute(
        text("""
            INSERT INTO fim.baselines 
            (id, agent_id, baseline_name, baseline_data, file_count, created_by, notes)
            VALUES (:id, :agent_id, :name, :data::jsonb, :count, :user_id, :notes)
        """),
        {
            "id": str(baseline_id),
            "agent_id": str(agent_uuid),
            "name": request.baseline_name,
            "data": scan[0],  # scan_data
            "count": scan[1],  # files_scanned
            "user_id": str(current_user.id),
            "notes": request.notes
        }
    )
    
    # Log history
    await db.execute(
        text("""
            INSERT INTO fim.baseline_history (baseline_id, action, performed_by, details)
            VALUES (:baseline_id, 'created', :user_id, :details::jsonb)
        """),
        {
            "baseline_id": str(baseline_id),
            "user_id": str(current_user.id),
            "details": f'{{"scan_id": "{str(scan_uuid)}"}}'
        }
    )
    
    await db.commit()
    
    return {
        "success": True,
        "baseline_id": str(baseline_id),
        "message": "Baseline created successfully"
    }

@router.post("/approve")
async def approve_baseline(
    request: BaselineApproveRequest,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    """Approve baseline (makes it immutable)"""
    try:
        baseline_uuid = uuid.UUID(request.baseline_id)
    except ValueError:
        raise HTTPException(400, "Invalid baseline ID")
    
    # Update baseline
    result = await db.execute(
        text("""
            UPDATE fim.baselines 
            SET is_approved = TRUE, approved_by = :user_id, approved_at = NOW()
            WHERE id = :baseline_id AND is_approved = FALSE
            RETURNING id
        """),
        {
            "baseline_id": str(baseline_uuid),
            "user_id": str(current_user.id)
        }
    )
    
    if not result.rowcount:
        raise HTTPException(404, "Baseline not found or already approved")
    
    # Log history
    await db.execute(
        text("""
            INSERT INTO fim.baseline_history (baseline_id, action, performed_by, details)
            VALUES (:baseline_id, 'approved', :user_id, :details::jsonb)
        """),
        {
            "baseline_id": str(baseline_uuid),
            "user_id": str(current_user.id),
            "details": f'{{"notes": "{request.notes or ""}"}}'
        }
    )
    
    await db.commit()
    
    return {
        "success": True,
        "message": "Baseline approved successfully"
    }

@router.get("/agent/{agent_id}")
async def get_agent_baseline(
    agent_id: str,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    """Get active baseline for an agent"""
    try:
        agent_uuid = uuid.UUID(agent_id)
    except ValueError:
        raise HTTPException(400, "Invalid agent ID")
    
    result = await db.execute(
        text("""
            SELECT id, baseline_name, file_count, created_at, is_approved, approved_at, notes
            FROM fim.baselines
            WHERE agent_id = :agent_id AND is_active = TRUE
        """),
        {"agent_id": str(agent_uuid)}
    )
    
    baseline = result.fetchone()
    
    if not baseline:
        raise HTTPException(404, "No active baseline found")
    
    return {
        "id": str(baseline[0]),
        "baseline_name": baseline[1],
        "file_count": baseline[2],
        "created_at": baseline[3].isoformat() if baseline[3] else None,
        "is_approved": baseline[4],
        "approved_at": baseline[5].isoformat() if baseline[5] else None,
        "notes": baseline[6]
    }

@router.get("/list")
async def list_baselines(
    agent_id: Optional[str] = None,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    """List all baselines"""
    query = """
        SELECT b.id, b.agent_id, a.hostname, b.baseline_name, b.file_count,
               b.created_at, b.is_active, b.is_approved
        FROM fim.baselines b
        JOIN fim.agents a ON b.agent_id = a.id
    """
    
    params = {}
    if agent_id:
        try:
            uuid.UUID(agent_id)
            query += " WHERE b.agent_id = :agent_id"
            params["agent_id"] = agent_id
        except ValueError:
            raise HTTPException(400, "Invalid agent ID")
    
    query += " ORDER BY b.created_at DESC"
    
    result = await db.execute(text(query), params)
    rows = result.fetchall()
    
    return {
        "baselines": [
            {
                "id": str(row[0]),
                "agent_id": str(row[1]),
                "hostname": row[2],
                "baseline_name": row[3],
                "file_count": row[4],
                "created_at": row[5].isoformat() if row[5] else None,
                "is_active": row[6],
                "is_approved": row[7]
            }
            for row in rows
        ],
        "total": len(rows)
    }
