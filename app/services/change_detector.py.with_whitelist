"""
Change Detection Service - The FIM Brain
Compares scans against baselines and generates alerts
"""
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select
from typing import Dict, List
import logging
import uuid
from datetime import datetime

from app.models.models import Scan, Baseline, Alert
from app.services.whitelist_checker import WhitelistChecker

logger = logging.getLogger(__name__)

class ChangeDetector:
    """Compares scans against baselines and generates alerts"""
    
    @staticmethod
    async def process_scan(scan_id: uuid.UUID, db: AsyncSession) -> Dict:
        """
        Process a new scan and detect changes
        Returns: dict with stats about changes detected
        """
        logger.info(f"Processing scan {scan_id} for changes")
        
        # 1. Get scan
        result = await db.execute(select(Scan).where(Scan.id == scan_id))
        scan = result.scalar_one_or_none()
        
        if not scan or not scan.scan_data:
            logger.warning(f"Scan {scan_id} has no data")
            return {'error': 'Scan not found or no data'}
        
        # 2. Get active baseline for this agent
        result = await db.execute(
            select(Baseline)
            .where(Baseline.agent_id == scan.agent_id)
            .where(Baseline.is_active == True)
            .limit(1)
        )
        baseline = result.scalar_one_or_none()
        
        if not baseline:
            logger.info(f"No baseline for agent {scan.agent_id}, skipping comparison")
            return {
                'status': 'no_baseline',
                'message': 'No active baseline to compare against'
            }
        
        logger.info(f"Comparing scan {scan_id} against baseline {baseline.id}")
        
        # 3. Compare files
        changes = ChangeDetector._compare_files(
            baseline.baseline_data.get('files', []),
            scan.scan_data.get('files', [])
        )
        
        # 4. Generate alerts for each change (with whitelist checking)
        alerts_created = 0
        alerts_suppressed = 0
        
        for change in changes:
            try:
                suppressed = await ChangeDetector._create_alert(scan.agent_id, change, db)
                if suppressed:
                    alerts_suppressed += 1
                else:
                    alerts_created += 1
            except Exception as e:
                logger.error(f"Failed to create alert: {e}")
        
        # 5. Update scan with change statistics
        scan.files_changed = len(changes)
        await db.commit()
        
        stats = {
            'status': 'completed',
            'total_changes': len(changes),
            'alerts_created': alerts_created,
            'alerts_suppressed': alerts_suppressed,
            'change_types': {
                'created': len([c for c in changes if c['type'] == 'created']),
                'modified': len([c for c in changes if c['type'] == 'modified']),
                'deleted': len([c for c in changes if c['type'] == 'deleted'])
            }
        }
        
        logger.info(f"Scan {scan_id}: {alerts_created} alerts created, {alerts_suppressed} suppressed - {stats['change_types']}")
        return stats
    
    @staticmethod
    def _compare_files(baseline_files: List[Dict], scan_files: List[Dict]) -> List[Dict]:
        """
        Compare two file lists and return detected changes
        """
        # Index files by path for O(1) lookup
        baseline_map = {f['path']: f for f in baseline_files}
        scan_map = {f['path']: f for f in scan_files}
        
        changes = []
        
        # Check for new and modified files
        for path, scan_file in scan_map.items():
            baseline_file = baseline_map.get(path)
            
            if not baseline_file:
                # NEW FILE DETECTED
                changes.append({
                    'type': 'created',
                    'path': path,
                    'severity': ChangeDetector._severity_for_new_file(path),
                    'current_state': scan_file,
                    'previous_state': None
                })
            elif ChangeDetector._file_changed(baseline_file, scan_file):
                # MODIFIED FILE DETECTED
                changes.append({
                    'type': 'modified',
                    'path': path,
                    'severity': ChangeDetector._calculate_severity(path, baseline_file, scan_file),
                    'current_state': scan_file,
                    'previous_state': baseline_file,
                    'changes': ChangeDetector._get_change_details(baseline_file, scan_file)
                })
        
        # Check for deleted files
        for path in baseline_map:
            if path not in scan_map:
                # DELETED FILE DETECTED
                changes.append({
                    'type': 'deleted',
                    'path': path,
                    'severity': ChangeDetector._severity_for_deleted_file(path),
                    'current_state': None,
                    'previous_state': baseline_map[path]
                })
        
        return changes
    
    @staticmethod
    def _file_changed(baseline: Dict, current: Dict) -> bool:
        """Check if a file has changed"""
        # Hash change = content modified
        if baseline.get('hash') != current.get('hash'):
            return True
        
        # Permission change
        if baseline.get('permissions') != current.get('permissions'):
            return True
        
        # Ownership change
        if baseline.get('owner') != current.get('owner'):
            return True
        
        if baseline.get('group') != current.get('group'):
            return True
        
        return False
    
    @staticmethod
    def _get_change_details(baseline: Dict, current: Dict) -> Dict:
        """Get specific details about what changed"""
        details = {}
        
        if baseline.get('hash') != current.get('hash'):
            details['hash'] = {
                'old': baseline.get('hash'),
                'new': current.get('hash')
            }
        
        if baseline.get('permissions') != current.get('permissions'):
            details['permissions'] = {
                'old': baseline.get('permissions'),
                'new': current.get('permissions')
            }
        
        if baseline.get('owner') != current.get('owner'):
            details['owner'] = {
                'old': baseline.get('owner'),
                'new': current.get('owner')
            }
        
        if baseline.get('group') != current.get('group'):
            details['group'] = {
                'old': baseline.get('group'),
                'new': current.get('group')
            }
        
        if baseline.get('size') != current.get('size'):
            details['size'] = {
                'old': baseline.get('size'),
                'new': current.get('size')
            }
        
        return details
    
    @staticmethod
    def _calculate_severity(path: str, baseline: Dict, current: Dict) -> str:
        """Calculate severity based on what changed and which file"""
        # Critical system files
        critical_files = [
            '/etc/passwd', '/etc/shadow', '/etc/sudoers',
            '/etc/ssh/sshd_config', '/etc/pam.d/'
        ]
        
        # High priority files
        high_priority_dirs = ['/etc/', '/usr/sbin/', '/usr/bin/']
        
        is_critical = any(path.startswith(cf) for cf in critical_files)
        is_high_priority = any(path.startswith(hp) for hp in high_priority_dirs)
        
        # Hash change = content modified
        if baseline.get('hash') != current.get('hash'):
            if is_critical:
                return 'critical'
            elif is_high_priority:
                return 'high'
            else:
                return 'medium'
        
        # Permission/ownership change
        if is_critical:
            return 'high'
        else:
            return 'medium'
    
    @staticmethod
    def _severity_for_new_file(path: str) -> str:
        """Determine severity for newly created file"""
        if any(path.startswith(d) for d in ['/etc/cron.d/', '/etc/sudoers.d/', '/usr/sbin/']):
            return 'high'
        elif path.startswith('/etc/'):
            return 'medium'
        else:
            return 'low'
    
    @staticmethod
    def _severity_for_deleted_file(path: str) -> str:
        """Determine severity for deleted file"""
        critical = ['/etc/passwd', '/etc/shadow', '/usr/sbin/sshd']
        if any(path == cf for cf in critical):
            return 'critical'
        elif path.startswith('/etc/') or path.startswith('/usr/sbin/'):
            return 'high'
        else:
            return 'medium'
    
    @staticmethod
    async def _create_alert(agent_id: uuid.UUID, change: Dict, db: AsyncSession) -> bool:
        """
        Create an alert for a detected change (if not whitelisted)
        Returns True if alert was suppressed by whitelist, False if created
        """
        
        # Check whitelist
        file_hash = change.get('current_state', {}).get('hash') if change.get('current_state') else None
        whitelist_match = await WhitelistChecker.check_file(
            change['path'], 
            file_hash,
            db
        )
        
        # If whitelisted, either suppress or downgrade severity
        is_whitelisted = whitelist_match is not None
        severity = change['severity']
        whitelist_rule_id = None
        
        if whitelist_match:
            whitelist_rule_id = uuid.UUID(whitelist_match['rule_id'])
            
            if whitelist_match['severity_override']:
                # Downgrade severity instead of suppressing
                severity = whitelist_match['severity_override']
                logger.info(f"Alert severity downgraded to {severity} by whitelist rule: {whitelist_match['rule_name']}")
            else:
                # Suppress alert entirely
                logger.info(f"Alert suppressed by whitelist rule: {whitelist_match['rule_name']}")
                await WhitelistChecker.log_match(
                    whitelist_match['rule_id'],
                    change['path'],
                    None,
                    True,
                    db
                )
                return True  # Alert was suppressed
        
        # Create the alert
        alert = Alert(
            id=uuid.uuid4(),
            agent_id=agent_id,
            alert_type=f"file_{change['type']}",
            severity=severity,
            file_path=change['path'],
            status='open',
            previous_state=change['previous_state'],
            current_state=change['current_state'],
            change_details={
                'change_type': change['type'],
                'detected_at': datetime.utcnow().isoformat(),
                'changes': change.get('changes', {})
            },
            detected_at=datetime.utcnow(),
            created_at=datetime.utcnow(),
            is_whitelisted=is_whitelisted,
            whitelist_rule_id=whitelist_rule_id
        )
        
        db.add(alert)
        logger.debug(f"Alert created: {change['type']} - {change['path']} ({severity})")
        
        return False  # Alert was created
